{
  "name": "bumi-bawah",
  "version": "1.0.0",
  "private": true,
  "description": "Bumi Bawah - edukasi setiap lapisan kerak bumi",
  "scripts": {
    "start": "php -S localhost:8000 -t public public/router.php",
    "css:build": "tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/app.css --minify",
    "css:watch": "tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/app.css --watch",
    "js:build": "node tools/minify-js.mjs",
    "build": "npm run css:build && npm run js:build",
    "images": "node tools/make-webp.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.17",
    "terser": "^5.46.0"
  }
}

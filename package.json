{
  "name": "bumi-bawah",
  "version": "1.1.0",
  "private": true,
  "description": "Bumi Bawah - situs statis edukasi lapisan kerak bumi",
  "scripts": {
    "build:pages": "node tools/build.mjs",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --watch",
    "build:js": "esbuild assets/js/core.js assets/js/home.js --bundle --format=iife --minify --entry-names=[name].min --outdir=assets/js",
    "build": "npm run build:pages && npm run build:css && npm run build:js",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.17"
  }
}
